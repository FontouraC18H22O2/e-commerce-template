# Copia este ficheiro para .env e preenche com os valores reais.
# NUNCA commitar o .env.

# Ligação à base de dados PostgreSQL (Railway)
DATABASE_URL="postgresql://user:password@host:port/dbname"

# Segredo usado para assinar o cookie de sessão — gerar uma string aleatória longa
SESSION_SECRET=""

# URL do frontend, usada na configuração de CORS
CLIENT_URL="http://localhost:5173"

# Stripe (modo de teste)
STRIPE_SECRET_KEY=""
# Fica vazio até ao deploy (ou até corrermos a Stripe CLI em dev) — é gerado
# quando criamos o endpoint de webhook real no dashboard da Stripe, apontado
# para a URL pública do backend.
STRIPE_WEBHOOK_SECRET=""

# Cloudinary (upload de imagens de produtos) — usa uma API Key dedicada
# à app, não a "Root", para poderes revogar sem afetar mais nada
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (email de recuperação de password) — sem conta verificada,
# só entrega para o email com que criaste a conta Resend
RESEND_API_KEY=""
# Opcional: remetente próprio, depois de verificares um domínio na Resend.
# Sem isto, usa-se o remetente de teste onboarding@resend.dev
RESEND_FROM_EMAIL=""

# Porta do servidor
PORT=4000

NODE_ENV="development"
