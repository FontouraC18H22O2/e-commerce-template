    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "resend": "^6.24.0",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
